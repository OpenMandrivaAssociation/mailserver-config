driver = pgsql
connect = host=localhost dbname=mail user=mailro password=m4i7p4s$w0rD
default_pass_scheme = SHA256
password_query = SELECT 488 as uid, 488 as gid, c_password AS password, c_uid AS user, domain FROM users WHERE c_uid = '%{user}'
user_query = SELECT 488 as uid, 488 as gid, '/srv/mail/%{user|domain}/%{user|username}' as home, 'vmail' as uid, 'vmail' as gid FROM users WHERE c_uid = '%{user}'
iterate_query = SELECT 488 as uid, 488 as gid, c_uid AS user, domain FROM users
